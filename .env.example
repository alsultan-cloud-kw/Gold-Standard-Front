# API (production default in code: https://api.goldstandardkw.com/api)
# For /gs-kyc local testing, run Django and use:
# VITE_BACKEND_API_URL=http://127.0.0.1:8000/api
# VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Clerk — Google / Apple sign-in (Clerk app: app_3EwkN0HFuTJjZWV2u90maxU8XXg)
# Dashboard → API Keys → React → Publishable key (production: pk_live_...)
# Apple + Google OAuth credentials go in Clerk Dashboard → SSO connections only — NOT in .env here
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Google One Tap — same Web client ID as Clerk Dashboard → Google → Use custom credentials.
# In Google Cloud Console, add Authorized JavaScript origins: https://www.goldstandardkw.com and https://goldstandardkw.com
# VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Optional — only if clerk subdomain DNS is NOT verified (requires api/clerk-fapi on Vercel):
# VITE_CLERK_PROXY_URL=/__clerk

# Cloudflare Turnstile — public site key (widget on login/register)
VITE_TURNSTILE_SITE_KEY=0x4AAAAAADkAZ-QKorXrXCKv

# Firebase Cloud Messaging (Web Push) — project goldstandard-dcca4
# From Firebase Console → Project settings → Your apps → Web
VITE_FIREBASE_API_KEY=AIzaSyDXmSVhx9pMdSFy6JxG5wM_UI1e4J3AxNw
VITE_FIREBASE_AUTH_DOMAIN=goldstandard-dcca4.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=goldstandard-dcca4
VITE_FIREBASE_STORAGE_BUCKET=goldstandard-dcca4.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=277505358501
VITE_FIREBASE_APP_ID=1:277505358501:web:96b54751f8a302e69dab4c
VITE_FIREBASE_MEASUREMENT_ID=G-39JGSRJVFJ
# Do NOT set VITE_FIREBASE_VAPID_KEY — VAPID is loaded from Django
# (VAPID_PUBLIC_KEY or FIREBASE_VAPID_KEY) so it is not baked into the Vercel bundle.

# Apple — Universal Links AASA + Smart App Banner
# Team ID → AASA appID (public/.well-known/apple-app-site-association)
# App Store ID → Smart App Banner in index.html
VITE_APPLE_TEAM_ID=6K3CUSQT22
VITE_IOS_APP_STORE_ID=6797245026

# Android — App Links (public/.well-known/assetlinks.json)
VITE_ANDROID_PACKAGE=com.goldstandardkw.mobile
VITE_ANDROID_SHA256_FINGERPRINT=FD:ED:61:72:38:40:23:01:F5:2B:00:BC:4A:25:77:69:DB:B2:3A:70:FB:E5:5F:9A:52:C0:04:3D:1A:2D:EB:5B
# When Play App Signing is enabled, add the App signing cert SHA-256 to assetlinks too

# Optional CDN hero for /gs-kyc gate (Cloudinary optimized URL). Falls back to /images/company-kyc-verify.jpg
# VITE_COMPANY_KYC_HERO_URL=https://res.cloudinary.com/YOUR_CLOUD/image/upload/f_auto,q_auto,w_1280/company-kyc-verify
