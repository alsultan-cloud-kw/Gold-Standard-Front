{
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/__clerk/:path*", "destination": "/api/clerk-fapi/:path*" },
    { "source": "/.well-known/(.*)", "destination": "/.well-known/$1" },
    {
      "source": "/((?!assets/|api/|og/|favicons/|videos/|fonts/|logo\\.png|robots\\.txt|sitemap\\.xml|account-data-deletion\\.html|legal/|legal/index\\.html|\\.well-known/).*)",
      "destination": "/index.html"
    }
  ]
}
